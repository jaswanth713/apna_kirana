# ==========================================
# LOCAL GENERAL STORE E-COMMERCE - BACKEND CONFIG
# ==========================================

# Neon PostgreSQL Connection URL
# Example format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Authentication Secret Key (Generate a random 32+ char string)
JWT_SECRET=supersecretjwtkey_change_in_production_ecomm_general_store_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Frontend URLs (comma-separated or single)
FRONTEND_URL=http://localhost:5173

# Environment (development | production)
ENVIRONMENT=development
PROJECT_NAME="Local General Store API"
